{
  "name": "@metreeca/gate",
  "description": "Zero-code model-driven endpoints for linked data resources.",
  "version": "0.11.0",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://metreeca.github.io/gate/",
  "bugs": {
    "url": "https://github.com/metreeca/gate/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/gate.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@metreeca/source": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./worker": {
      "@metreeca/source": "./src/worker.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ln",
    "build": "rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.13.0",
    "@metreeca/http": "^0.5.0",
    "@metreeca/tape": "^0.12.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.5.0",
    "@types/express": "^5.0.6",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
